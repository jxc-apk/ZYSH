    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 背景 -->
    <path
        android:fillColor="#2F6BFF"
        android:pathData="M0,0h108v108h-108z" />

    <!-- 纸箱：进销存的"库存" -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M30,44h48v34H30z" />
    <path
        android:fillColor="#DCE7FF"
        android:pathData="M30,44h48v9H30z" />
    <path
        android:fillColor="#2F6BFF"
        android:pathData="M50,36h8v16h-8z" />

    <!-- 折线：报表 -->
